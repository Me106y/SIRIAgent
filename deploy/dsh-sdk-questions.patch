+  // SIRIAgent: bridge user questions to the SDK client over JSON-RPC. The
+  // user-questions service dispatches an agent-scoped waterfall; this process
+  // forwards each request to the client and answers with its result.
+  const questionEvents = ctx as unknown as {
+    on(
+      name: 'user-questions/request',
+      handler: (request: { questions: unknown, wait?: { callId?: string } }) => Promise<unknown>,
+    ): void
+  }
+  questionEvents.on('user-questions/request', async (request) => {
+    return transport.request('userQuestion/ask', {
+      questions: request.questions,
+      callId: request.wait?.callId ?? null,
+    })
+  })
