<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title><style>
:root{
  --ink:#070b10; --panel:#0d141c; --panel-2:#111a24; --line:#1e2c3a; --line-soft:#16222e;
  --txt:#dfe8f1; --muted:#7d93a8; --dim:#8a9caf;
  --rule:#54697d;
  --amber:#f0a52b; --cyan:#48c7d9; --red:#e0574a; --green:#5fbf8f;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
  --sans:"Noto Sans CJK SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
html,body{margin:0;background:var(--ink);color:var(--txt);font-family:var(--sans);line-height:1.65}
body{display:grid;grid-template-columns:288px minmax(0,1fr);min-height:100vh}
::selection{background:rgba(72,199,217,.28);color:#fff}
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
*{scrollbar-color:var(--line) transparent;scrollbar-width:thin}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:var(--line);border-radius:8px}
::-webkit-scrollbar-track{background:transparent}

/* ---------- sidebar ---------- */
.side{border-right:1px solid var(--line);background:linear-gradient(180deg,#0a1017,#080d13 55%);padding:26px 22px 30px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:26px;overflow:auto}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit}
.brand svg{flex:none}
.brand b{font-size:16px;letter-spacing:.01em;font-weight:700}
.brand span{display:block;font-size:12px;color:var(--dim);letter-spacing:.16em;margin-top:1px}
.meta{display:grid;gap:14px;border-top:1px solid var(--line-soft);padding-top:20px}
.meta .row{display:grid;gap:3px}
.meta .k{font-size:12px;color:var(--dim);letter-spacing:.08em}
.meta .v{font-size:14px;color:var(--txt)}
.meta .v.mono{font-family:var(--mono);font-size:13px;letter-spacing:-.01em}
.meta .v em{font-style:normal;color:var(--amber)}
nav{display:grid;gap:2px;border-top:1px solid var(--line-soft);padding-top:20px}
nav a{display:flex;gap:10px;align-items:baseline;padding:8px 10px;border-radius:6px;color:var(--muted);text-decoration:none;font-size:13.5px}
nav a:hover{background:var(--panel-2);color:var(--txt)}
nav a[aria-current="true"]{background:var(--panel-2);color:var(--txt);box-shadow:inset 2px 0 0 var(--amber)}
nav a[aria-current="true"] .idx{color:var(--amber)}
nav a .idx{font-family:var(--mono);font-size:12px;color:var(--dim);min-width:16px}
.side .foot{margin-top:auto;font-size:12px;color:var(--dim);line-height:1.7;border-top:1px solid var(--line-soft);padding-top:16px}

/* ---------- main ---------- */
main{min-width:0;padding:44px 46px 96px}
h1{font-size:clamp(26px,2.4vw,34px);line-height:1.28;margin:0 0 10px;font-weight:700;letter-spacing:-.015em;max-width:22ch}
h1 em{font-style:normal;color:var(--amber)}
.sub{color:var(--muted);font-size:14px;margin:0;max-width:70ch}
.sub .mono{font-family:var(--mono);color:var(--txt);font-size:13px}

.verdict{margin:22px 0 0;padding:16px 0 0;border-top:1px solid var(--line);max-width:78ch;font-size:15px;color:#c8d6e4}
.verdict b{color:var(--amber);font-weight:700}
.verdict .flag{color:var(--red)}

/* instrument strip */
.strip{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;margin:34px 0 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.strip div{padding:14px 16px 15px;border-right:1px solid var(--line-soft)}
.strip div:last-child{border-right:0}
.strip .lab{font-size:12px;color:var(--dim);letter-spacing:.06em}
.strip .val{font-family:var(--mono);font-size:20px;letter-spacing:-.02em;margin-top:2px}
.strip .val small{font-size:12px;color:var(--muted);margin-left:2px}
.strip .val.amber{color:var(--amber)}

section{margin-top:52px;scroll-margin-top:24px}
h2{font-size:17px;margin:0 0 4px;font-weight:700;letter-spacing:-.01em}
.lede{color:var(--muted);font-size:13px;margin:0 0 18px;max-width:72ch}

table{width:100%;border-collapse:collapse;font-size:13.5px}
th{text-align:left;padding:9px 12px;font-size:12px;letter-spacing:.06em;color:var(--dim);border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:11px 12px;border-bottom:1px solid var(--line-soft);vertical-align:middle}
tr:hover td{background:#0b121a}
td.num,th.num{font-family:var(--mono);font-variant-numeric:tabular-nums;text-align:right;letter-spacing:-.01em}
.swatch{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:9px;vertical-align:1px}
.tag{font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:4px;padding:1px 6px}

/* map */
.mapwrap{max-width:780px;border:1px solid var(--line);border-radius:10px;background:radial-gradient(120% 120% at 70% 10%,#0e1922,#080d12 70%);overflow:hidden}
.mapwrap canvas{display:block;width:100%;height:auto;aspect-ratio:16/9}
.transport{display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;padding:12px 16px;border-top:1px solid var(--line);background:#0a1118}
.play{width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:#0f1922;color:var(--cyan);display:grid;place-items:center;cursor:pointer;padding:0}
.play:hover{border-color:var(--cyan);background:#13212c}
.play svg{width:13px;height:13px;fill:currentColor}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:22px;background:transparent;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:3px;background:var(--line);border-radius:2px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;border-radius:50%;background:var(--amber);margin-top:-4.5px;box-shadow:0 0 0 4px rgba(240,165,43,.16)}
input[type=range]::-moz-range-track{height:3px;background:var(--line);border-radius:2px}
input[type=range]::-moz-range-thumb{width:12px;height:12px;border:0;border-radius:50%;background:var(--amber);box-shadow:0 0 0 4px rgba(240,165,43,.16)}
.clock{font-family:var(--mono);font-size:13px;color:var(--txt);font-variant-numeric:tabular-nums;min-width:150px;text-align:right}
.clock .pct{color:var(--amber)}
.legend{display:flex;flex-wrap:wrap;gap:18px;padding:12px 16px 14px;font-size:12px;color:var(--muted);border-top:1px solid var(--line-soft)}
.legend .swatch{vertical-align:0}

/* revisit */
.rv{margin:18px 0 0;max-width:820px}
.rv .axis{position:relative;height:34px;border-bottom:1px solid var(--line)}
.rv .bar{position:absolute;top:14px;height:6px;border-radius:3px;background:linear-gradient(90deg,var(--cyan),var(--amber))}
.rv .tick{position:absolute;top:8px;width:2px;height:14px;border-radius:1px;transform:translateX(-1px)}
.rv .ticks{display:flex;justify-content:space-between;font-family:var(--mono);font-size:12px;color:var(--dim);padding-top:7px}
.rvlegend{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:12px;font-size:12.5px;color:var(--muted)}
.rvlegend span{display:inline-flex;align-items:center;gap:7px;white-space:nowrap}
.rvlegend b{font-family:var(--mono);font-weight:600;color:var(--txt);font-variant-numeric:tabular-nums}
.rvlegend i{width:8px;height:8px;border-radius:2px;display:inline-block}

ul.notes{margin:10px 0 0;padding-left:18px;color:var(--muted);font-size:13px;max-width:76ch}
ul.notes li{margin:5px 0}
pre.err{background:#1a0f0f;border:1px solid #43201d;color:#f0b4ad;padding:14px;border-radius:8px;font-family:var(--mono);font-size:12px;overflow:auto}

footer{margin-top:60px;padding-top:18px;border-top:1px solid var(--line);color:var(--dim);font-size:12px;line-height:1.8;max-width:82ch}

@media (max-width:1080px){
  body{grid-template-columns:1fr}
  .side{position:static;height:auto;flex-direction:row;flex-wrap:wrap;gap:18px;align-items:flex-start}
  .side .foot{width:100%;margin-top:6px}
  main{padding:30px 20px 70px}
  .strip{grid-template-columns:repeat(3,1fr)}
  .strip div{border-bottom:1px solid var(--line-soft)}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
}
/* ---------- export ---------- */
.export-pdf{position:fixed;top:16px;right:18px;z-index:9999;padding:8px 15px;border:1px solid rgba(72,199,217,.65);border-radius:999px;background:rgba(10,16,23,.9);color:var(--cyan);font:600 13px var(--sans);cursor:pointer;backdrop-filter:blur(8px);box-shadow:0 6px 20px rgba(0,0,0,.35)}
.export-pdf:hover{background:rgba(72,199,217,.14);border-color:var(--cyan)}
@media print{
  .export-pdf{display:none}
  body{display:block;background:#fff;color:#111}
  .side{display:none}
  main{padding:0;max-width:none}
  section{break-inside:avoid}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  @page{size:A4;margin:12mm}
}
</style></head><body>
<button class="export-pdf" type="button" onclick="window.print()" title="导出为 PDF">导出 PDF</button>

<aside class="side">
  <div class="brand">
    <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true">
      <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#48c7d9"/><stop offset="1" stop-color="#f0a52b"/></linearGradient></defs>
      <ellipse cx="20" cy="20" rx="16" ry="9" transform="rotate(-28 20 20)" fill="none" stroke="url(#lg)" stroke-width="1.4" opacity=".9"/>
      <circle cx="20" cy="20" r="4.6" fill="none" stroke="#dfe8f1" stroke-width="1.5"/>
      <circle cx="20" cy="20" r="1.6" fill="#f0a52b"/>
      <circle cx="31.5" cy="9.5" r="2.1" fill="#48c7d9"/>
      <path d="M6 32.5h5M13.5 32.5h2.5M18.5 32.5h9" stroke="var(--rule)" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
    <div><b>SIRIAgent</b><span>IMAGING PLAN</span></div>
  </div>

  <div class="meta">
    <div class="row"><span class="k">目标区域</span><span class="v">{{ aoi_name }}</span></div>
    <div class="row"><span class="k">任务模式</span><span class="v">{{ mode_label }}</span></div>
    <div class="row"><span class="k">窗口开始</span><span class="v mono">{{ window_start }}</span></div>
    <div class="row"><span class="k">窗口结束</span><span class="v mono">{{ window_end }}</span></div>
    <div class="row"><span class="k">时长</span><span class="v mono"><em>{{ window_hours }} h</em>{% if extended %}（已扩窗）{% endif %}</span></div>
  </div>

  <nav>
    <a href="#plan"><span class="idx">01</span>编成</a>
    <a href="#cover"><span class="idx">02</span>覆盖与回放</a>
    <a href="#revisit"><span class="idx">03</span>重访</a>
    <a href="#notes"><span class="idx">04</span>口径与精度</a>
  </nav>

  <div class="foot">{{ accuracy_note }}<br>{{ algo_label }}</div>
</aside>

<main>
  <h1>覆盖 <em>{{ "%.0f"|format(target_pct) }}%</em>，需要 <em>{{ sat_count }}</em> 颗星</h1>
  <p class="sub">
    <span class="mono">{{ window_start }}</span> → <span class="mono">{{ window_end }}</span>
    （北京时间）· {{ aoi_area }} km² · {{ grid_points }} 个网格点
  </p>

  <div class="verdict">
    {% if feasible %}<b>达标。</b>{% else %}<b class="flag">未达标。</b>{% endif %}
    实际覆盖 {{ "%.1f"|format(coverage_pct) }}%，重访 P95 {{ gap.p95_hours if gap.p95_hours is not none else "—" }} 小时，
    最大间隔 {{ gap.max_hours if gap.max_hours is not none else "—" }} 小时。
    {% if uncovered_grid %}<span class="flag">有 {{ uncovered_grid }} 个格点在窗口内从未被覆盖。</span>{% elif under_covered %}<span>有 {{ under_covered }} 个格点在窗口内只被访问一次，重访间隔按窗口长度计。</span>{% endif %}
  </div>

  <div class="strip">
    <div><div class="lab">卫星</div><div class="val">{{ sat_count }}</div></div>
    <div><div class="lab">覆盖率</div><div class="val amber">{{ "%.1f"|format(coverage_pct) }}<small>%</small></div></div>
    <div><div class="lab">重访 P95</div><div class="val">{{ gap.p95_hours if gap.p95_hours is not none else "—" }}<small>h</small></div></div>
    <div><div class="lab">MRT</div><div class="val">{{ gap.mrt_hours if gap.mrt_hours is not none else "—" }}<small>h</small></div></div>
    <div><div class="lab">网格</div><div class="val">{{ "%.3f"|format(grid_spacing) }}<small>°</small></div></div>
    <div><div class="lab">未覆盖格点</div><div class="val">{{ uncovered_grid }}</div></div>
  </div>

  <section id="plan">
    <h2>编成</h2>
    <p class="lede">按覆盖贡献排序；分辨率与幅宽是该星实际参与计算的模式。</p>
    <table><thead><tr>
      <th>卫星</th><th>类型</th><th>模式</th><th class="num">分辨率</th><th class="num">幅宽</th><th class="num">覆盖占比</th>
    </tr></thead><tbody>
    {% for s in sats %}
    <tr>
      <td><span class="swatch" data-sat="{{ s.sat_id }}" style="background:{{ s.color }}"></span>{{ s.name }}</td>
      <td><span class="tag">{{ s.sensor_label }}</span></td>
      <td>{{ s.mode_used }}</td>
      <td class="num">{{ s.resolution_m }} m</td>
      <td class="num">{{ s.swath_km }} km</td>
      <td class="num">{{ "%.1f"|format(s.coverage_pct) }}%</td>
    </tr>
    {% endfor %}
    </tbody></table>
  </section>

  <section id="cover">
    <h2>覆盖与回放</h2>
    <p class="lede">拖动时间轴回放覆盖累积过程；点按播放按 {{ speed_label }} 速度推进。每个点是一个网格单元，颜色为首次覆盖它的卫星。</p>
    <div class="mapwrap">
      <canvas id="map" width="1280" height="720" role="img" aria-label="覆盖分布与回放"></canvas>
      <div class="transport">
        <button class="play" id="play" aria-label="播放">
          <svg id="ico" viewBox="0 0 16 16"><path d="M4 2l10 6-10 6z"/></svg>
        </button>
        <input id="scrub" type="range" min="0" max="{{ events_count }}" value="0" step="1" aria-label="回放时间轴">
        <div class="clock"><span id="now">—</span> · <span class="pct" id="pct">0%</span></div>
      </div>
      <div class="legend">
        {% for s in sats %}<span><span class="swatch" style="background:{{ s.color }}"></span>{{ s.name }}</span>{% endfor %}
        <span><span class="swatch" style="background:#2b4557"></span>未覆盖</span>
      </div>
    </div>
  </section>

  <section id="revisit">
    <h2>重访</h2>
    <p class="lede">同一颗星一次过境在格点上连续命中的采样点先并成一次访问，再统计访问间隔；只被访问一次的点记窗口长度。</p>
    <div class="rv">
      <div class="axis" id="axis">
        <div class="bar" id="rvbar"></div>
      </div>
      <div class="ticks"><span>0 h</span><span>{{ "%.0f"|format(window_hours / 2) }} h</span><span>{{ window_hours }} h</span></div>
      <div class="rvlegend" id="rvlegend"></div>
    </div>
  </section>

  <section id="notes">
    <h2>口径与精度</h2>
    <ul class="notes">
      {% for n in notes %}<li>{{ n }}</li>{% endfor %}
      {% if single_pass %}<li><b>窗口内仅 1 次有效过境</b>：P95 / MRT / MAX 均等于窗口长度 {{ window_hours }} h，只说明本次单次覆盖，不能作为重访能力。</li>{% endif %}
      <li>覆盖率与重访间隔均为估算值，不得作为精确面积或保证重访的依据。</li>
    </ul>
    <footer>{{ algo_label }}<br>生成于 {{ generated_at }} · 网格 {{ "%.3f"|format(grid_spacing) }}° / {{ grid_points }} 点</footer>
  </section>
</main>

<script id="planData" type="application/json">{{ map_json | safe }}</script>
<script>
(function(){
  var D = JSON.parse(document.getElementById('planData').textContent);
  var cv = document.getElementById('map'), ctx = cv.getContext('2d');
  var dpr = Math.min(2, window.devicePixelRatio || 1);
  var W = cv.width, H = cv.height;
  var bb = D.bbox, ev = D.events, TOTAL = D.total;
  var pad = 46, cos = Math.cos((bb[1]+bb[3])/2*Math.PI/180);
  var dx = (bb[2]-bb[0])*cos, dy = bb[3]-bb[1];
  var sc = Math.min((W-2*pad)/dx, (H-2*pad)/dy);
  var ox = (W-dx*sc)/2, oy = (H-dy*sc)/2;
  function PX(lo,la){ return [ox+(lo-bb[0])*cos*sc, oy+(bb[3]-la)*sc]; }

  var outline = D.outline.map(function(p){ return PX(p[0],p[1]); });
  var cum = [], acc = 0;
  ev.forEach(function(e){ acc += e.points.length; cum.push(acc); });

  function draw(upto){
    ctx.setTransform(dpr,0,0,dpr,0,0);
    ctx.clearRect(0,0,W,H);
    ctx.save(); ctx.scale(1,1);
    ctx.beginPath();
    outline.forEach(function(p,i){ i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]); });
    ctx.closePath();
    ctx.fillStyle = '#0d1a24'; ctx.fill();
    ctx.strokeStyle = '#2f4a60'; ctx.lineWidth = 1.6; ctx.stroke();

    for (var i=0;i<upto;i++){
      var e = ev[i], col = D.colors[e.sat_id] || '#48c7d9';
      ctx.fillStyle = col;
      var pts = e.points;
      for (var k=0;k<pts.length;k++){
        var p = PX(pts[k][0], pts[k][1]);
        ctx.fillRect(p[0]-1.6, p[1]-1.6, 3.2, 3.2);
      }
    }
    if (upto>0){
      ctx.fillStyle = '#2b4557';
      for (var u=0;u<D.uncovered.length;u++){
        var q = PX(D.uncovered[u][0], D.uncovered[u][1]);
        ctx.fillRect(q[0]-1.6, q[1]-1.6, 3.2, 3.2);
      }
    }
    ctx.restore();
  }

  var scrub = document.getElementById('scrub');
  var nowEl = document.getElementById('now');
  var pctEl = document.getElementById('pct');
  var btn = document.getElementById('play');
  var ico = document.getElementById('ico');
  var timer = null, idx = 0;

  function label(i){
    if (i<=0) return D.start_label;
    return ev[i-1].label;
  }
  function paint(i){
    idx = i;
    draw(i);
    nowEl.textContent = label(i);
    var p = i>0 ? (cum[i-1]/TOTAL*100) : 0;
    pctEl.textContent = p.toFixed(1)+'%';
  }

  scrub.addEventListener('input', function(){ stop(); paint(+scrub.value); });
  function tick(){
    if (idx >= ev.length){ stop(); return; }
    idx++; scrub.value = idx; paint(idx);
    if (idx >= ev.length) stop();
  }
  function play(){
    if (idx >= ev.length) { idx = 0; scrub.value = 0; paint(0); }
    timer = setInterval(tick, {{ tick_ms }});
    ico.innerHTML = '<path d="M4 3h3v10H4zM9 3h3v10H9z"/>';
    btn.setAttribute('aria-label','暂停');
  }
  function stop(){
    if (timer){ clearInterval(timer); timer = null; }
    ico.innerHTML = '<path d="M4 2l10 6-10 6z"/>';
    btn.setAttribute('aria-label','播放');
  }
  btn.addEventListener('click', function(){ timer ? stop() : play(); });

  var bar = document.getElementById('rvbar');
  var axis = document.getElementById('axis');
  var lg = document.getElementById('rvlegend');
  var wh = D.window_hours;
  var marks = [];
  if (D.p50 != null) marks.push({k:'MRT', v:D.p50, c:'#48c7d9'});
  if (D.p95 != null) marks.push({k:'P95', v:D.p95, c:'#f0a52b'});
  if (D.max != null) marks.push({k:'MAX', v:D.max, c:'#e0574a'});

  // 数值相同的标注合并成一条，轴上也只画一根刻度，避免重叠
  var merged = [];
  marks.forEach(function(m){
    var hit = null;
    for (var i=0;i<merged.length;i++){ if (Math.abs(merged[i].v - m.v) < 0.05) { hit = merged[i]; break; } }
    if (hit) { hit.k += ' / ' + m.k; } else { merged.push({k:m.k, v:m.v, c:m.c}); }
  });

  if (merged.length){
    var lo = Math.min.apply(null, merged.map(function(m){return m.v;}));
    var hi = Math.min(wh, Math.max.apply(null, merged.map(function(m){return m.v;})));
    bar.style.left = (Math.max(0, lo/wh*100)) + '%';
    bar.style.width = Math.max(1.2, (hi-lo)/wh*100) + '%';
    merged.forEach(function(m){
      var pct = Math.min(99.6, Math.max(0.4, m.v/wh*100));
      var t = document.createElement('div');
      t.className = 'tick'; t.style.left = pct + '%'; t.style.background = m.c;
      t.title = m.k + ' ' + m.v + ' h';
      axis.appendChild(t);

      var item = document.createElement('span');
      var chip = document.createElement('i'); chip.style.background = m.c;
      var val = document.createElement('b'); val.textContent = m.v + ' h';
      item.appendChild(chip); item.appendChild(document.createTextNode(m.k + ' ')); item.appendChild(val);
      lg.appendChild(item);
    });
  }

  // 侧栏导航：原生锚点 + 兜底 scrollIntoView，并高亮当前节
  var links = Array.prototype.slice.call(document.querySelectorAll('nav a[href^="#"]'));
  links.forEach(function(a){
    a.addEventListener('click', function(ev){
      var el = document.querySelector(a.getAttribute('href'));
      if (!el) return;
      ev.preventDefault();
      el.scrollIntoView({behavior: 'smooth', block: 'start'});
      try { history.replaceState(null, '', a.getAttribute('href')); } catch (e) {}
      setActive(a.getAttribute('href').slice(1));
    });
  });
  function setActive(id){
    links.forEach(function(a){
      a.setAttribute('aria-current', a.getAttribute('href') === '#'+id ? 'true' : 'false');
    });
  }
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if (en.isIntersecting) setActive(en.target.id); });
    }, {rootMargin: '-45% 0px -50% 0px', threshold: 0});
    document.querySelectorAll('section[id]').forEach(function(sec){ io.observe(sec); });
  }
  setActive('plan');

  paint(0);
  // 入场：一次淡入，不重复动画
  cv.style.opacity = 0; cv.style.transition = 'opacity .5s ease-out';
  requestAnimationFrame(function(){ cv.style.opacity = 1; });
})();
</script>
</body></html>
